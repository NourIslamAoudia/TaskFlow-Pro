{
  "name": "taskflow-pro",
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_FIREBASE_API_KEY": "@taskflow_firebase_api_key",
      "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "@taskflow_firebase_auth_domain",
      "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "@taskflow_firebase_project_id",
      "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "@taskflow_firebase_storage_bucket",
      "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "@taskflow_firebase_messaging_sender_id",
      "NEXT_PUBLIC_FIREBASE_APP_ID": "@taskflow_firebase_app_id",
      "NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID": "@taskflow_firebase_measurement_id"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "functions": {
    "pages/api/**/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "regions": ["iad1"]
}